local function formatNumber(n)
    if not n then return "0" end
    if n >= 1e9 then return string.format("%.1fB", n / 1e9)
    elseif n >= 1e6 then return string.format("%.1fM", n / 1e6)
    elseif n >= 1e3 then return string.format("%.1fK", n / 1e3)
    else return tostring(math.floor(n)) end
end

local function getSessionDuration()
    local secs = os.time() - (State.sessionStartTime > 0 and State.sessionStartTime or os.time())
    local m = math.floor(secs / 60)
    local s = secs % 60
    return string.format("%dm %ds", m, s)
end

-- ============================================================
-- SEND WEBHOOK
-- Mirrors thebest__1_.lua sendWebhook() exactly —
-- rich embed with Current Stats + Session Info fields
-- ============================================================
local function sendWebhook(title, description, color)
    if State.webhookUrl == "" or State.webhookUrl == nil then return end
    task.spawn(function()
        pcall(function()
            local currentPeli    = getPeli()
            local currentLevel   = getLevel()
            local peliGained     = currentPeli  - State.sessionStartPeli
            local levelsGained   = currentLevel - State.sessionStartLevel

            local embed = {
                ["embeds"] = { {
                    ["title"]       = title,
                    ["description"] = description,
                    ["color"]       = color or 3447003,
                    ["fields"] = {
                        {
                            ["name"]   = "Current Stats",
                            ["value"]  = string.format(
                                "Level: %d (+%d)\nPeli: %s (+%s)",
                                currentLevel, levelsGained,
                                formatNumber(currentPeli), formatNumber(peliGained)
                            ),
                            ["inline"] = true
                        },
                        {
                            ["name"]   = "Session Info",
                            ["value"]  = string.format(
                                "Duration: %s\nPlayer: %s",
                                getSessionDuration(), player.Name
                            ),
                            ["inline"] = true
                        }
                    },
                    ["footer"]    = { ["text"] = "Kaitun Hub | " .. os.date("%H:%M:%S") },
                    ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
                } }
            }

            local reqFn = request or http_request or
                (syn and syn.request) or
                (fluxus and fluxus.request) or
                (krnl and krnl.request)
            if reqFn then
                reqFn({
                    Url     = State.webhookUrl,
                    Method  = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body    = game:GetService("HttpService"):JSONEncode(embed)
                })
            end
        end)
    end)
end

-- ============================================================
-- LEVEL MONITOR — fires webhook on level up (every 3s poll)
-- Mirrors thebest__1_.lua startLevelMonitoring()
-- ============================================================
local function startLevelMonitor()
    State.connections.levelMonitor = task.spawn(function()
        while State.active do
            task.wait(3)
            pcall(function()
                local currentLevel = getLevel()
                if currentLevel > State.lastLevel and State.lastLevel > 0 then
                    if State.webhookSendLevelUp then
                        sendWebhook(
                            "Level Up! 🎉",
                            string.format("Reached **Level %d**!", currentLevel),
                            65280  -- green
                        )
                    end
                    Window:Notify({
                        Title    = "Level Up!",
                        Desc     = "Now Level " .. currentLevel,
                        Duration = 3,
                        Kind     = "success"
                    })
                end
                State.lastLevel = currentLevel
            end)
        end
    end)
end


