local function collectGunStats()
    local stats = {}
    local statNames = {
        "Level", "Peli", "Strength", "Defense", "Speed",
        "Fruit", "Sword", "Gun", "Devil", "Beli",
        "Bounty", "Honor", "Raid", "RaidPoints",
        "Race", "Blox", "Mastery", "Accessory",
    }
    for _, name in ipairs(statNames) do
        local val = getStat(name)
        if val ~= 0 then stats[name] = val end
    end
    pcall(function()
        local statsFolder = ReplicatedStorage:FindFirstChild("Stats" .. getPlayerName())
        if statsFolder and statsFolder:FindFirstChild("Stats") then
            for _, child in ipairs(statsFolder.Stats:GetChildren()) do
                if child:IsA("ValueBase") then
                    stats[child.Name] = child.Value
                end
            end
        end
    end)
    pcall(function()
        local rifle = player.Backpack:FindFirstChild("Rifle")
            or (player.Character and player.Character:FindFirstChild("Rifle"))
        if rifle then
            stats["GunName"] = rifle.Name
            stats["GunTool"] = rifle
            for _, v in ipairs(rifle:GetDescendants()) do
                if v:IsA("ValueBase") then
                    stats["Gun_" .. v.Name] = v.Value
                end
            end
        end
    end)
    pcall(function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then stats["ShootOriginCFrame"] = hrp.CFrame end
    end)
    return stats
end

local function hasRifle()
    local ok, v = pcall(function()
        local bp = player:FindFirstChild("Backpack")
        local ch = player.Character
        return (bp and bp:FindFirstChild("Rifle") ~= nil)
            or (ch and ch:FindFirstChild("Rifle") ~= nil)
    end)
    return ok and v or false
end

local function isRifleEquipped()
    local ok, v = pcall(function()
        local ch = player.Character
        return ch and ch:FindFirstChild("Rifle") ~= nil
    end)
    return ok and v or false
end

local function isSpawnAt(name)
    local ok, v = pcall(function()
        local pn    = getPlayerName()
        local stats = ReplicatedStorage:FindFirstChild("Stats" .. pn)
        if not stats then return false end
        local spawnPoint = stats:FindFirstChild("SpawnPoint")
        if not spawnPoint then return false end
        return spawnPoint.Value == name
    end)
    return ok and v or false
end

