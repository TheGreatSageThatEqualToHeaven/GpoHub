local function startAutoGunMastery()
    if State.autoGunMasteryActive then return end
    State.autoGunMasteryActive = true
    State.connections.autoGunMastery = task.spawn(function()
        while State.active and State.autoGunMasteryActive do
            pcall(function()
                local data = ReplicatedStorage:FindFirstChild("Stats" .. getPlayerName())
                if data and data:FindFirstChild("Stats") then
                    local skillPoints = data.Stats:FindFirstChild("SkillPoints")
                    if skillPoints and skillPoints.Value > 0 then
                        local pointsToAdd = skillPoints.Value
                        ReplicatedStorage:WaitForChild("Events"):WaitForChild("stats")
                            :FireServer("GunMastery", nil, pointsToAdd)
                        task.wait(0.15)
                    end
                end
            end)
            task.wait(1)
        end
    end)
end

