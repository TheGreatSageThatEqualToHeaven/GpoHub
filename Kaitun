-- ============================================================
local cachedPrompts = {}
local function cacheProximityPrompts()
    table.clear(cachedPrompts)
    local descendants = workspace:GetDescendants()
    for i, desc in ipairs(descendants) do
        if desc:IsA("ProximityPrompt") then
            local txt = ((desc.ObjectText or "") .. (desc.ActionText or "") .. (desc.Name or "")):lower()
            if txt:find("open") or txt:find("peli") or txt:find("chest") then
                local p = desc.Parent
                local pos
                if p and p:IsA("BasePart") then pos = p.Position
                elseif p and p:IsA("Model") then
                    local part = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart")
                    pos = part and part.Position
                end
                if pos then cachedPrompts[desc] = { position = pos } end
            end
        end
        if i % 100 == 0 then task.wait() end
    end
end

local function tryTriggerPrompts()
    local hrp = State.character and State.character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position
    for prompt, data in pairs(cachedPrompts) do
        pcall(function()
            if prompt and prompt.Parent and prompt.Enabled then
                if (pos - data.position).Magnitude <= (prompt.MaxActivationDistance or 0) then
                    fireproximityprompt(prompt)
                end
            else
                cachedPrompts[prompt] = nil
            end
        end)
    end
end

local visitedParts = {}
local function findNearestChest()
    local env = workspace:FindFirstChild("Env")
    if not env then return nil end
    local hrp = State.character and State.character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local pos = hrp.Position
    local nearest, minDist = nil, math.huge
    for _, obj in ipairs(env:GetChildren()) do
        if obj.Name == "Part" and obj:IsA("BasePart") and not visitedParts[obj] then
            for _, d in ipairs(obj:GetDescendants()) do
                if d:IsA("ProximityPrompt") then
                    local dist = (pos - obj.Position).Magnitude
                    if dist < minDist then nearest, minDist = obj, dist end
                    break
                end
            end
        end
    end
    if not nearest then
        local count = 0
        for _ in pairs(visitedParts) do count = count + 1 end
        if count > 50 then table.clear(visitedParts) end
    end
    return nearest
end

local function serverHop()
    Window:Notify({ Title = "Kaitun", Desc = "No chests — server hopping...", Duration = 3, Kind = "warn" })
    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(
            "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
        ))
    end)
    if ok and data and data.data then
        for _, sv in ipairs(data.data) do
            if sv.playing ~= sv.maxPlayers and sv.id ~= game.JobId then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, sv.id) end)
                task.wait(6)
                return
            end
        end
    end
    task.wait(10)
end

local function farmPeliLoop()
    local searchFails = 0
    cacheProximityPrompts()

    State.character = getCharacter()
    local hrp = State.character:WaitForChild("HumanoidRootPart")
    local hum = State.character:WaitForChild("Humanoid")

    hum.PlatformStand = true
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    pcall(function()
        ReplicatedStorage:WaitForChild("Events"):WaitForChild("takestam"):FireServer(0.505, "dash")
    end)
    task.wait(0.5)
    hrp.CFrame = CFrame.new(hrp.CFrame.Position + Vector3.new(0, ALTITUDE, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    State.connections.antigravity = RunService.Heartbeat:Connect(function()
        pcall(function()
            if hrp.Parent then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end)

    State.connections.dashLoop = task.spawn(function()
        while State.active do
            task.wait(1.5)
            pcall(function()
                ReplicatedStorage:WaitForChild("Events"):WaitForChild("takestam"):FireServer(0.505, "dash")
            end)
        end
    end)

    State.connections.promptClicker = task.spawn(function()
        while State.active do
            tryTriggerPrompts()
            RunService.Heartbeat:Wait()
        end
    end)

    while State.active do
        local currentPeli = getPeli()
        if currentPeli >= TARGET_PELI or hasRifle() then break end

        hrp, State.character = getFreshHRP()
        local chest = findNearestChest()

        if not chest then
            searchFails = searchFails + 1
            if searchFails >= 3 then
                serverHop()
                searchFails = 0
            end
            task.wait(1)
        else
            searchFails = 0
            visitedParts[chest] = true
            tweenTeleport(chest.Position + Vector3.new(0, 50, 0), TRAVEL_SPEED, false)
            if not State.active then return end
            tweenTeleport(chest.Position + Vector3.new(0, 3, 0), TRAVEL_SPEED, false)
            task.wait(1)
        end

        RunService.Heartbeat:Wait()
    end

    if State.connections.antigravity then
        State.connections.antigravity:Disconnect()
        State.connections.antigravity = nil
    end

    hum.PlatformStand = false
    hum.WalkSpeed = 16
    hum.JumpPower = 50
end

