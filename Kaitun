        end

        local function shootAtTarget(targetHead)
            local gs = State.gunStats
            local shootOrigin
            pcall(function()
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then shootOrigin = hrp.CFrame end
            end)
            if not shootOrigin then
                shootOrigin = gs and gs.ShootOriginCFrame or CFrame.new(
                    7838.86767578125, -2150.707275390625, -17139.39453125,
                    0.971501350402832,   0.218903049826622,   0.09092045575380325,
                    0.08188118785619736, 0.05003693699836731, -0.9953853487968445,
                   -0.22244228422641754, 0.9744627475738525,   0.030686836689710617
                )
            end
            local currentPosition = targetHead.CFrame.Position
            local fireArgs = {
                "fire",
                {
                    Start    = shootOrigin,
                    Gun      = (gs and gs.GunName) or "Rifle",
                    joe      = "true",
                    Position = currentPosition,
                    Level    = gs and gs.Level    or getStat("Level"),
                    Peli     = gs and gs.Peli     or getStat("Peli"),
                    Strength = gs and gs.Strength or getStat("Strength"),
                    Defense  = gs and gs.Defense  or getStat("Defense"),
                    Speed    = gs and gs.Speed    or getStat("Speed"),
                    Fruit    = gs and gs.Fruit    or getStat("Fruit"),
                    Sword    = gs and gs.Sword    or getStat("Sword"),
                    GunStat  = gs and gs.Gun      or getStat("Gun"),
                    Devil    = gs and gs.Devil    or getStat("Devil"),
                    Beli     = gs and gs.Beli     or getStat("Beli"),
