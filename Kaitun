-- ============================================================
-- FISHMAN ISLAND ROUTE
-- ============================================================
local function doFishmanRoute()
    local CAVE_POS  = Vector3.new(1838, 4, -12173)
    local ROBO_POS  = Vector3.new(7977, -2153, -17074)
    local FARM_POS_ = Vector3.new(7839, -2151, -17135)

    while State.active do
        local hrp, ch = getFreshHRP()
        if not hrp then task.wait(1) continue end

        local island = getCurrentIsland()
        local islandName = island and island.Name or ""

        if islandName ~= "Fishman Island" then
            local caveDistXZ = (Vector2.new(CAVE_POS.X, CAVE_POS.Z)
                - Vector2.new(hrp.Position.X, hrp.Position.Z)).Magnitude

            local portalPart
            pcall(function() portalPart = workspace.AreaTeleporters.FirstSea.Fishman.Part end)

            if caveDistXZ > 300 then
                Window:Notify({ Title = "Kaitun", Desc = "Moving to Fishman Cave...", Duration = 3, Kind = "info" })
                tweenTeleport(CAVE_POS, TRAVEL_SPEED, false)

            elseif portalPart then
                local portalPos = portalPart.Position
                local portalDistXZ = (Vector2.new(portalPos.X, portalPos.Z)
                    - Vector2.new(hrp.Position.X, hrp.Position.Z)).Magnitude

                if portalDistXZ < 10 then
                    Window:Notify({ Title = "Kaitun", Desc = "At portal — waiting stamina...", Duration = 3, Kind = "info" })
                    repeat task.wait() until getStamina() > 10 or not State.active
                    if not State.active then return end

                    ReplicatedStorage:WaitForChild("Events"):WaitForChild("takestam"):FireServer(0.525, "dash")
                    task.wait(0.5)
                    hrp, ch = getFreshHRP()
                    hrp.CFrame = CFrame.new(portalPos)
                    Window:Notify({ Title = "Kaitun", Desc = "Entering Fishman Island — waiting 10s...", Duration = 10, Kind = "info" })
                    task.wait(10)
                else
                    Window:Notify({ Title = "Kaitun", Desc = "Moving to Fishman portal...", Duration = 3, Kind = "info" })
                    tweenTeleport(portalPos, TRAVEL_SPEED, false)
                end
            end

        elseif islandName == "Fishman Island" then
            if getSpawnPoint() ~= "Fishman Island" then
                Window:Notify({ Title = "Kaitun", Desc = "Setting spawn via Robo...", Duration = 3, Kind = "info" })
                tweenTeleport(ROBO_POS, UNDERWATER_SPEED, true)
                if not State.active then return end

                pcall(function()
                    local robo = workspace.NPCs:FindFirstChild("Robo")
                    if robo then
                        ReplicatedStorage:WaitForChild("Events"):WaitForChild("SetSpawn"):FireServer(nil, robo)
                        ReplicatedStorage:WaitForChild("Events"):WaitForChild("Quest"):InvokeServer({ "npcChat", true })
                    end
                end)
                task.wait(1)

            elseif (FARM_POS_ - hrp.Position).Magnitude > 10 then
                Window:Notify({ Title = "Kaitun", Desc = "Moving to farm position...", Duration = 3, Kind = "info" })
                tweenTeleport(FARM_POS_, UNDERWATER_SPEED, true)
                if not State.active then return end

                Window:Notify({ Title = "Kaitun", Desc = "Arrived at farm!", Duration = 4, Kind = "success" })
                State.arrivedAtFarm = true
                return
            else
                State.arrivedAtFarm = true
                return
            end
        end

        task.wait(0.1)
    end
end

-- ============================================================
-- BECKY QUEST — accept + return to farm (level 190+)
--
-- Reverse-engineered from Feral Kaitun decompiled script:
--   Condition (line 8983): currentQuest ~= "Help becky" AND level >= 190
--   Becky position (line 6694): Vector3(7733, -2176, -17218)
--   Accept pattern (line 7624, L_2068): quit → wait 1.5s → takequest
--   Return to farm (line 6737+): back to Vector3(7838, -2151, -17134)
-- ============================================================
local function acceptBeckyQuest()
    if not State.active then return end

    local QuestEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Quest")

    Window:Notify({
        Title    = "Becky Quest",
        Desc     = "Swimming to Becky NPC...",
        Duration = 3,
        Kind     = "info"
    })

    tweenTeleport(BECKY_POS, TRAVEL_SPEED, true)
    if not State.active then return end
    task.wait(0.3)
    if not State.active then return end

    local accepted = false
    local attempts = 0
    repeat
        attempts = attempts + 1
        pcall(function() QuestEvent:InvokeServer({ "quit" }) end)
        task.wait(0.3)
        if not State.active then return end
        pcall(function() QuestEvent:InvokeServer({ "takequest", BECKY_QUEST }) end)
        task.wait(0.3)
        accepted = isQuestActive() or getCurrentQuest() == BECKY_QUEST
    until accepted or attempts >= 5 or not State.active

    if accepted then
        Window:Notify({ Title = "Becky Quest", Desc = "Quest accepted! Returning to farm...", Duration = 3, Kind = "success" })
    else
        Window:Notify({ Title = "Becky Quest", Desc = "Could not accept quest — resuming farm.", Duration = 3, Kind = "warn" })
    end

    if not State.active then return end
    tweenTeleport(FARM_POS, TRAVEL_SPEED, true)
end

