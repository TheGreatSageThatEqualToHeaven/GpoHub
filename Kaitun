                    Honor    = gs and gs.Honor    or getStat("Honor"),
                    Mastery  = gs and gs.Mastery  or getStat("Mastery"),
                }
            }
            GunManager:FireServer(unpack(fireArgs))
            task.wait(0.1)
            pcall(function()
                gunFunctions:InvokeServer("reload", {
                    Gun     = (gs and gs.GunName) or "Rifle",
                    Level   = gs and gs.Level    or getStat("Level"),
                    GunStat = gs and gs.Gun      or getStat("Gun"),
                    Mastery = gs and gs.Mastery  or getStat("Mastery"),
                })
            end)
        end

        local lastBeckyCheck     = 0
        local BECKY_CHECK_INTERVAL = 10

        while State.active do

            -- ── BECKY QUEST CHECK ─────────────────────────────────────
            -- Mirrors feral script logic: if level >= 190 and not on Becky quest, go take it
            local now = tick()
            if now - lastBeckyCheck >= BECKY_CHECK_INTERVAL then
                lastBeckyCheck = now
                pcall(function()
                    local lvl   = getLevel()
                    local quest = getCurrentQuest()
                    if lvl >= BECKY_MIN_LVL and quest ~= BECKY_QUEST then
                        Window:Notify({
                            Title    = "Becky Quest",
                            Desc     = "Lvl " .. lvl .. " — going to accept Becky quest!",
                            Duration = 4,
                            Kind     = "info"
                        })
                        acceptBeckyQuest()
                    end
                end)
            end
            -- ─────────────────────────────────────────────────────────

            local targets = getTargets()
            if #targets == 0 then
                task.wait(0.1)
            else
                for _, targetNPC in ipairs(targets) do
                    if not State.active then return end
                    if targetNPC and targetNPC.Parent then
                        local targetHead = targetNPC:FindFirstChild("Head")
                        local humanoid   = targetNPC:FindFirstChild("Humanoid")
                        if targetHead and humanoid and humanoid.Health > 0 then
                            while humanoid.Health > 0 and targetNPC.Parent and State.active do
                                targetHead = targetNPC:FindFirstChild("Head")
                                if targetHead then
                                    shootAtTarget(targetHead)
                                else
                                    break
                                end
                                task.wait(0.05)
                            end
                            task.wait(0.3)
                        end
                    end
                end
            end
            task.wait(0.25)
        end
    end)
end

