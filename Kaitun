-- MAIN KAITUN FLOW
-- ============================================================
local function startKaitun()
    if State.active then return end
    State.active        = true
    State.arrivedAtFarm = false
    -- Seed session stats for webhook embed
    State.sessionStartTime  = os.time()
    State.sessionStartLevel = getLevel()
    State.sessionStartPeli  = getPeli()
    State.lastLevel         = getLevel()

    State.gunStats = collectGunStats()
    Window:Notify({
        Title    = "Kaitun",
        Desc     = "Stats loaded! Lvl " .. (State.gunStats.Level or 0)
                   .. " | Gun " .. (State.gunStats.Gun or 0)
                   .. " | Mastery " .. (State.gunStats.Mastery or 0),
        Duration = 4,
        Kind     = "info"
    })

    startAutoGunMastery()
    Window:Notify({
        Title    = "Gun Mastery",
        Desc     = "Auto dumping SkillPoints into GunMastery...",
        Duration = 3,
        Kind     = "info"
    })

    Window:Notify({ Title = "Kaitun", Desc = "Starting Kaitun farm...", Duration = 4, Kind = "success" })

    State.thread = task.spawn(function()
        if not hasRifle() then
            local currentPeli = getPeli()
            if currentPeli < TARGET_PELI then
                Window:Notify({ Title = "Kaitun", Desc = "Farming Peli ("..currentPeli.."/"..TARGET_PELI..")...", Duration = 4, Kind = "info" })
                farmPeliLoop()
                if not State.active then return end
            end

            Window:Notify({ Title = "Kaitun", Desc = "Target Peli reached — buying Rifle...", Duration = 3, Kind = "info" })
            buyRifle()
            if not State.active then return end
            task.wait(3)
        end

        State.gunStats = collectGunStats()

        Window:Notify({ Title = "Kaitun", Desc = "Equipping Rifle...", Duration = 2, Kind = "info" })
        State.character = getCharacter()
        State.shouldKeepRifle = true
        equipRifle()
        task.wait(2)

        State.gunStats = collectGunStats()
        startRifleWatcher()
        startLevelMonitor()

        if not State.arrivedAtFarm then
            doFishmanRoute()
            if not State.active then return end
        end

        -- Immediate Becky check on farm start if already 190+
        if State.active and getLevel() >= BECKY_MIN_LVL and getCurrentQuest() ~= BECKY_QUEST then
            Window:Notify({
                Title    = "Becky Quest",
                Desc     = "Level 190+ detected — accepting Becky quest first!",
                Duration = 4,
                Kind     = "info"
            })
            acceptBeckyQuest()
            if not State.active then return end
        end

        if State.active then
            Window:Notify({ Title = "Kaitun", Desc = "Farming Fishman Karate Users!", Duration = 3, Kind = "success" })
            farmFishmanKarateUsers()
        end
    end)
end

local function stopKaitun()
    Window:Notify({ Title = "Kaitun", Desc = "Farm stopped.", Duration = 3, Kind = "warn" })
    cleanup()
    if State.thread then
        pcall(function() task.cancel(State.thread) end)
        State.thread = nil
    end
end

