-- ============================================================
local function equipRifle()
    task.spawn(function()
        for attempt = 1, 5 do
            if not State.active then return end
            pcall(function()
                ReplicatedStorage:WaitForChild("Events"):WaitForChild("Tools")
                    :InvokeServer("equip", "Rifle")
            end)
            task.wait(0.4)
            pcall(function()
                local ch  = player.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local bp  = player:FindFirstChild("Backpack")
                if hum and bp then
                    local rifle = bp:FindFirstChild("Rifle")
                    if rifle and rifle:IsA("Tool") then hum:EquipTool(rifle) end
                end
            end)
            task.wait(0.6)
            if isRifleEquipped() then
                State.shouldKeepRifle = true
                return
            end
        end
        pcall(function()
            local ch = player.Character
            local bp = player:FindFirstChild("Backpack")
            if ch and bp then
                local rifle = bp:FindFirstChild("Rifle")
                if rifle then rifle.Parent = ch end
            end
        end)
        task.wait(0.3)
        State.shouldKeepRifle = isRifleEquipped()
    end)
end

-- ============================================================
-- BUY RIFLE from Lily
-- ============================================================
local function buyRifle()
    local now = tick()
    if now - State.lastRifleBuyTime < State.rifleBuyCooldown and State.riflePurchaseDone then return end
    if hasRifle() then
        Window:Notify({ Title = "Rifle", Desc = "Already owned!", Duration = 2, Kind = "success" })
        return
    end

    local hrp = State.character and State.character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    Window:Notify({ Title = "Kaitun", Desc = "Navigating to Lily to buy Rifle...", Duration = 3, Kind = "info" })

    local lily = workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Lily")
    if lily then
        local lilyPart = lily:FindFirstChild("HumanoidRootPart") or lily.PrimaryPart or lily:FindFirstChildWhichIsA("BasePart")
        if lilyPart then
            tweenTeleport(lilyPart.Position + Vector3.new(0, 3, 0), TRAVEL_SPEED, false)
            if not State.active then return end
            task.wait(1)

            local currentPeli = getPeli()
            if currentPeli < TARGET_PELI then
                Window:Notify({ Title = "Rifle", Desc = "Not enough Peli: " .. currentPeli .. "/" .. TARGET_PELI, Duration = 3, Kind = "warn" })
                return
            end

            pcall(function()
                ReplicatedStorage:WaitForChild("Events"):WaitForChild("Shop"):InvokeServer(
                    workspace:WaitForChild("BuyableItems"):WaitForChild("Rifle"), 1
                )
            end)
            State.riflePurchaseDone = true
            State.lastRifleBuyTime  = tick()
            task.wait(2)

            if hasRifle() then
                Window:Notify({ Title = "Rifle", Desc = "Purchased successfully!", Duration = 3, Kind = "success" })
            else
                Window:Notify({ Title = "Rifle", Desc = "Purchase may have failed.", Duration = 3, Kind = "warn" })
            end
        end
    else
        Window:Notify({ Title = "Rifle", Desc = "Lily NPC not found in NPCs folder.", Duration = 3, Kind = "warn" })
    end
end

