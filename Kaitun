local function startRifleWatcher()
    State.connections.rifleWatcher = task.spawn(function()
        while State.active do
            task.wait(5)
            pcall(function()
                if State.shouldKeepRifle and hasRifle() and not isRifleEquipped() then
                    local now = tick()
                    if now - State.lastRifleEquipTime >= State.rifleEquipCooldown then
                        State.lastRifleEquipTime = now
                        equipRifle()
                    end
                end
            end)
        end
    end)
end

-- ============================================================
-- CLEANUP
-- ============================================================
local function cleanup()
    State.active   = false
    State.gunStats = nil
    stopAutoGunMastery()
    for k, v in pairs(State.connections) do
        pcall(function()
            if typeof(v) == "RBXScriptConnection" then v:Disconnect()
            elseif type(v) == "thread" then task.cancel(v) end
        end)
        State.connections[k] = nil
    end
    pcall(function()
        local ch  = player.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false hum.WalkSpeed = 16 hum.JumpPower = 50 end
        if hrp then hrp.Anchored = false hrp.AssemblyLinearVelocity = Vector3.zero end
    end)
end

