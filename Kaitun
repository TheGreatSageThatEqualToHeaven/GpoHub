-- ============================================================
-- TPGPO TWEEN TELEPORT
-- ============================================================
local lastDashFire = 0
local function fireDash(hrp)
    if tick() - lastDashFire < 0.5 then return end
    lastDashFire = tick()
    pcall(function()
        ReplicatedStorage:WaitForChild("Events"):WaitForChild("takestam")
            :FireServer(0.54, "dash", hrp.CFrame)
    end)
end

local function makeRayParams(character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local list = { character, workspace:FindFirstChild("PlayerCharacters"), workspace:FindFirstChild("Effects") }
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    params.FilterDescendantsInstances = list
    return params
end

local function getGroundY(x, z, params, fallbackY, underwater)
    local origin = Vector3.new(x, fallbackY + 300, z)
    local dir    = Vector3.new(0, -2000, 0)
    local hit    = workspace:Raycast(origin, dir, params)
    while hit and (not hit.Instance.CanCollide and not hit.Instance.CanQuery
        or hit.Instance.Name == "Leaves") do
        hit = workspace:Raycast(hit.Position - Vector3.new(0, 0.1, 0), dir, params)
    end
    if not hit then return underwater and fallbackY or math.max(fallbackY, 2) end
    local groundY = hit.Position.Y + 5
    return underwater and groundY or math.max(groundY, 2)
end

local function isTpStrikeActive()
    local hit = false
    pcall(function()
        for _, obj in ipairs(player.PlayerGui.Notifications:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local t = obj.Text
                if t == "TP" or t == "Strike" or t:find("Strike") then
                    hit = true
                    return
                end
            end
        end
    end)
    return hit
end

local function tweenTeleport(dest, speed, underwater)
    if not State.active then return end
    local ch  = player.Character or player.CharacterAdded:Wait()
    local hrp = ch:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    speed      = speed or TRAVEL_SPEED
    underwater = underwater or false

    if (Vector2.new(hrp.Position.X, hrp.Position.Z)
        - Vector2.new(dest.X, dest.Z)).Magnitude < 2 then
        hrp.CFrame   = CFrame.new(dest)
        hrp.Velocity = Vector3.zero
        return
    end

    local params = makeRayParams(ch)

    while State.active do
        local origin = hrp.Position
        local dist2D = (Vector2.new(origin.X, origin.Z) - Vector2.new(dest.X, dest.Z)).Magnitude
        if dist2D < 2 then break end

        if isTpStrikeActive() then
            task.wait(5)
            ch  = player.Character or player.CharacterAdded:Wait()
            hrp = ch:WaitForChild("HumanoidRootPart", 5)
            if not hrp then return end
            params = makeRayParams(ch)
            continue
        end

        fireDash(hrp)

        local dt    = RunService.RenderStepped:Wait()
        local step  = math.min(speed * dt, dist2D)
        local dir2D = Vector2.new(dest.X - origin.X, dest.Z - origin.Z).Unit
        local newX  = origin.X + dir2D.X * step
        local newZ  = origin.Z + dir2D.Y * step
        local newY  = getGroundY(newX, newZ, params, origin.Y, underwater)

        hrp.Velocity = Vector3.zero
        hrp.CFrame   = CFrame.new(newX, newY, newZ)
    end

    if not State.active then return end
    local finalY = getGroundY(dest.X, dest.Z, params, hrp.Position.Y, underwater)
    hrp.CFrame   = CFrame.new(dest.X, finalY, dest.Z)
    hrp.Velocity = Vector3.zero
end

