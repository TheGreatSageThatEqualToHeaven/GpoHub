local function formatNumber(n)
    if not n then return "0" end
    if n >= 1e6 then return string.format("%.1fM", n / 1e6)
    elseif n >= 1e3 then return string.format("%.1fK", n / 1e3)
    else return tostring(math.floor(n)) end
end

local function getSessionDuration()
    local secs = os.time() - (State.sessionStartTime > 0 and State.sessionStartTime or os.time())
    return string.format("%dm %ds", math.floor(secs / 60), secs % 60)
end

local function sendWebhook(title, description, color)
    if State.webhookUrl == "" then return end
    task.spawn(function()
        pcall(function()
            local embed = {
                ["embeds"] = { {
                    ["title"]       = title,
                    ["description"] = description,
                    ["color"]       = color or 3447003,
                    ["fields"] = {
                        {
                            ["name"]   = "Session",
                            ["value"]  = string.format("Catches: %d\nPeli: %s\nDuration: %s",
                                State.sessionCatches, formatNumber(getPeli()), getSessionDuration()),
                            ["inline"] = true,
                        },
                        {
                            ["name"]   = "Player",
                            ["value"]  = player.Name,
                            ["inline"] = true,
                        },
                    },
                    ["footer"]    = { ["text"] = "Kaitun Hub | " .. os.date("%H:%M:%S") },
                    ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                } }
            }
            local reqFn = request or http_request
                or (syn and syn.request)
                or (fluxus and fluxus.request)
                or (krnl and krnl.request)
            if reqFn then
                reqFn({
                    Url     = State.webhookUrl,
                    Method  = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body    = HttpService:JSONEncode(embed),
                })
            end
        end)
    end)
end

-- ============================================================
-- MOVEMENT — tpgpo tween teleport
-- ============================================================
local HoroTpRunning = false
local lastDashFire  = 0

local function fireDash(hrp)
    if tick() - lastDashFire < 0.5 then return end
    lastDashFire = tick()
    pcall(function()
        ReplicatedStorage:WaitForChild("Events"):WaitForChild("takestam")
            :FireServer(0.54, "dash", hrp.CFrame)
    end)
end

local function makeRayParams(ch)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local list = { ch, workspace:FindFirstChild("PlayerCharacters"), workspace:FindFirstChild("Effects") }
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    params.FilterDescendantsInstances = list
    return params
end

local function getGroundY(x, z, altY, rp, underwater)
    local hit = workspace:Raycast(Vector3.new(x, altY, z), Vector3.new(0, -2000, 0), rp)
    while hit and (not hit.Instance.CanCollide and not hit.Instance.CanQuery
        or hit.Instance.Name == "Leaves") do
        hit = workspace:Raycast(hit.Position - Vector3.new(0, 0.1, 0), Vector3.new(0, -2000, 0), rp)
    end
    if not hit then return underwater and altY or math.max(altY, 2) end
    return underwater and (hit.Position.Y + 5) or math.max(hit.Position.Y + 5, 2)
end

local function isTpStrikeActive()
    local hit = false
    pcall(function()
        for _, obj in ipairs(player.PlayerGui.Notifications:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local t = obj.Text
                if t == "TP" or t == "Strike" or t:find("Strike") then hit = true return end
            end
        end
    end)
    return hit
end

local function tweenTeleport(dest, speed, underwater)
    if HoroTpRunning or not State.active then return end
    speed      = speed or TRAVEL_SPEED
    underwater = underwater or false
    local ch  = player.Character or player.CharacterAdded:Wait()
    local hrp = ch:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end
    HoroTpRunning = true
    local rp   = makeRayParams(ch)
    local altY = hrp.Position.Y + 300
    local startPos = hrp.Position

    if (Vector2.new(startPos.X, startPos.Z) - Vector2.new(dest.X, dest.Z)).Magnitude < 2 then
        hrp.CFrame = CFrame.new(dest.X, getGroundY(dest.X, dest.Z, altY, rp, underwater), dest.Z)
        hrp.Velocity = Vector3.zero
        HoroTpRunning = false
        return
    end

    if not underwater then
        startPos = Vector3.new(startPos.X, altY, startPos.Z)
        hrp.CFrame = CFrame.new(startPos)
        hrp.Velocity = Vector3.zero
    end

    local dist2D  = (Vector2.new(startPos.X, startPos.Z) - Vector2.new(dest.X, dest.Z)).Magnitude
    local elapsed = 0
    local dashThread = task.spawn(function()
        while HoroTpRunning and State.active do fireDash(hrp) task.wait(1.5) end
    end)

    while elapsed < dist2D / speed and State.active do
        if isTpStrikeActive() then
            task.wait(5)
            ch  = player.Character or player.CharacterAdded:Wait()
            hrp = ch:WaitForChild("HumanoidRootPart", 5)
            if not hrp then pcall(function() task.cancel(dashThread) end) HoroTpRunning = false return end
            rp       = makeRayParams(ch)
            startPos = hrp.Position
            elapsed  = 0
            continue
        end
        local dt    = RunService.RenderStepped:Wait()
        elapsed     = elapsed + dt
        local alpha = math.clamp(elapsed / (dist2D / speed), 0, 1)
        local newX  = startPos.X + (dest.X - startPos.X) * alpha
        local newZ  = startPos.Z + (dest.Z - startPos.Z) * alpha
        hrp.Velocity = Vector3.zero
        hrp.CFrame   = CFrame.new(newX, getGroundY(newX, newZ, altY, rp, underwater), newZ)
    end

    pcall(function() task.cancel(dashThread) end)
    if State.active then
        hrp.CFrame   = CFrame.new(dest.X, getGroundY(dest.X, dest.Z, altY, rp, underwater), dest.Z)
        hrp.Velocity = Vector3.zero
    end
    HoroTpRunning = false
end

-- ============================================================
-- CLEANUP
-- ============================================================
local function waitSec(s)
    local t = 0
    while t < s do
        if not State.active then return false end
        t = t + (task.wait(0.1) or 0.1)
    end
    return true
end

local function cleanup()
    State.active = false
    State.phase  = "idle"
    HoroTpRunning = false
    pcall(function()
        local r = State.fishingRemote
        if r then r:InvokeServer({ Action = "Cancel" }) end
    end)
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:UnequipTools() end
    end)
    if State.thread then
        pcall(function() task.cancel(State.thread) end)
        State.thread = nil
    end
    for k, v in pairs(State.connections) do
        pcall(function()
            if typeof(v) == "RBXScriptConnection" then v:Disconnect()
            elseif type(v) == "thread" then task.cancel(v) end
        end)
        State.connections[k] = nil
    end
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false hum.WalkSpeed = 16 hum.JumpPower = 50 end
    end)
end

