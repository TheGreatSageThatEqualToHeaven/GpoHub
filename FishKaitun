local function sellFish()
    if not State.autoSell then return end
    local remote = getShopRemote()
    local desc   = getToolDesc()
    if not remote or not desc then return end
    local peli = getPeli()
    for name, _ in pairs(getInventory()) do
        local d = desc[name]
        if d and d.Type == "Fish" then
            if peli >= 1000000 then return end
            if d.Rare and table.find(State.sellRarities, d.Rare) then
                pcall(function() remote:InvokeServer({ Method = "SellFish", Fish = name, All = false }) end)
                task.wait(0.5)
                peli = getPeli()
            end
        end
    end
end

