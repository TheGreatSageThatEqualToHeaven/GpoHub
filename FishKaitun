local function getStatsFolder()
    return ReplicatedStorage:FindFirstChild("Stats" .. player.Name)
end

local function getPeli()
    local ok, v = pcall(function() return getStatsFolder().Stats.Peli.Value end)
    return ok and v or 0
end

local function getInventory()
    local ok, v = pcall(function()
        return HttpService:JSONDecode(getStatsFolder().Inventory.Inventory.Value)
    end)
    return ok and v or {}
end

local function hasItem(name)
    local ch = player.Character
    if ch and ch:FindFirstChild(name) then return true end
    local bp = player:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild(name) then return true end
    local inv = getInventory()
    return (inv[name] ~= nil and (inv[name] or 0) > 0)
end

local function hasRod()
    local pref = State.rodPreference
    if pref ~= "Auto" and hasItem(pref) then State.rodName = pref; return true end
    for _, r in ipairs(ROD_LIST) do
        if hasItem(r) then State.rodName = r; return true end
    end
    return false
end

local function hasBait()
    local pref = State.baitPreference
    if pref ~= "Auto" and hasItem(pref) then State.baitName = pref; return true end
    for _, b in ipairs(BAIT_LIST) do
        if hasItem(b) then State.baitName = b; return true end
    end
    return false
end

local function getFreshHRP()
