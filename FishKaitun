local function isMerchantVisible()
    local found, visible = false, false
    pcall(function()
        local node = player:WaitForChild("PlayerGui").Compass.Compass.Guiders:FindFirstChild("Traveling Merchant")
        if node then found = true visible = node.Visible end
    end)
    return found, visible
end

local function getMerchantPos()
    local ok, pos = pcall(function()
        local cg = ReplicatedStorage:FindFirstChild("CompassGuider")
        if not cg then return nil end
        for _, child in ipairs(cg:GetChildren()) do
            if child.Name:lower():find("merchant") then
                if child:IsA("Vector3Value") and child.Value.Magnitude > 0 then return child.Value end
                if child:IsA("CFrameValue") then return child.Value.Position end
            end
        end
    end)
    return ok and pos or nil
end

local function getMerchantGui()
    local pg = player:FindFirstChild("PlayerGui")
    return pg and (pg:FindFirstChild("MerchentShop") or pg:FindFirstChild("MerchantShop")) or nil
end

local function getMerchantPrices()
    local gui = getMerchantGui()
    if not gui then return {} end
    local raw = gui:GetAttribute("Prices")
    if not raw or raw == "" then return {} end
    local ok, v = pcall(function() return HttpService:JSONDecode(raw) end)
    return (ok and type(v) == "table") and v or {}
end

local function openMerchantShop()
    if getMerchantGui() then return true end
    local ev = ReplicatedStorage:FindFirstChild("Events")
        and ReplicatedStorage.Events:FindFirstChild("TravelingMerchentRemote")
    if not ev then return false end
    pcall(function() ev:InvokeServer("OpenShop") end)
    local t0 = tick()
    while tick() - t0 < 4 and State.active do
        if getMerchantGui() then return true end
        task.wait(0.2)
    end
    return getMerchantGui() ~= nil
end

local function buyMerchantItem(name)
    local gui = getMerchantGui()
    if not gui then return false end
    local ev = ReplicatedStorage.Events:FindFirstChild("TravelingMerchentRemote")
    if not ev then return false end
    return pcall(function() ev:InvokeServer(name, gui:GetAttribute("Seed")) end)
end

local function isVisitedMerchantPos(pos)
    for _, vp in ipairs(State.visitedMerchantPositions) do
        if (pos - vp).Magnitude < 50 then return true end
    end
    return false
end

local function dist2D(a, b)
    return (Vector2.new(a.X, a.Z) - Vector2.new(b.X, b.Z)).Magnitude
end

local function tweenToMerchant(targetPos)
    local waited = 0
    while HoroTpRunning and waited < 3 do task.wait(0.1) waited += 0.1 end
    HoroTpRunning = false

    for attempt = 1, 6 do
        if not (State.active and State.merchantEnabled) then return false end
        local hrp = getFreshHRP()
        if not hrp then task.wait(0.5) continue end
        local live = getMerchantPos()
        if live then targetPos = live end
        if dist2D(hrp.Position, targetPos) <= 10 then return true end
        HoroTpRunning = false
        tweenTeleport(targetPos + Vector3.new(0, 5, 0), TRAVEL_SPEED, false)
        local w = 0; while HoroTpRunning and w < 15 do task.wait(0.1) w += 0.1 end
        HoroTpRunning = false
        local hrp2 = getFreshHRP()
        if hrp2 and dist2D(hrp2.Position, getMerchantPos() or targetPos) <= 10 then return true end
        task.wait(0.5)
    end
    return false
end

local function returnToFarm()
    if not State.active then return end
    HoroTpRunning = false; task.wait(0.3)
    tweenTeleport(FARM_POSITION, TRAVEL_SPEED, false); task.wait(0.5)
    if State.active and State.phase == "merchant" then
        State.phase = "fishing"
    end
end

local function processMerchantPurchases()
    if not openMerchantShop() then
        Window:Notify({ Title = "Merchant", Desc = "Couldn't open the shop.", Duration = 3, Kind = "warn" })
        returnToFarm(); return
    end

    local prices = getMerchantPrices()
    local bought = 0
    local peli   = getPeli()

    for name, _ in pairs(State.merchantBuyables) do
        if not State.active or not State.merchantEnabled then break end
        if not State.merchantBlacklist[name] then
            local data  = prices[name]
            local stock = data and (data.remaining or 0) or 0
            local price = data and (data.price or 0) or 0
            if stock > 0 and price > 0 and peli >= price then
                Window:Notify({ Title = "Merchant", Desc = ("Buying %s × %d"):format(name, stock), Duration = 3, Kind = "info" })
                for _ = 1, stock do
                    if not State.active then break end
                    peli = getPeli()
                    if peli < price then break end
                    local before = (getMerchantPrices()[name] or {}).remaining or 0
                    buyMerchantItem(name)
                    task.wait(0.4)
                    local after = (getMerchantPrices()[name] or {}).remaining or 0
                    if after == before then
                        State.merchantBlacklist[name] = true
                        Window:Notify({ Title = "Merchant", Desc = name .. " failed — skipping for this spawn.", Duration = 3, Kind = "warn" })
                        break
                    end
                    bought = bought + 1
                end
            end
        end
    end

    if bought > 0 then
        Window:Notify({ Title = "Merchant", Desc = "Bought " .. bought .. " item(s).", Duration = 3, Kind = "success" })
    end
    returnToFarm()
end

local function merchantLoop()
    while State.active and State.merchantEnabled do
        if next(State.merchantBuyables) ~= nil then
            local found, visible = isMerchantVisible()
            if found and visible then
                local pos = getMerchantPos()
                if pos and not isVisitedMerchantPos(pos) then
                    table.insert(State.visitedMerchantPositions, pos)
                    State.merchantBlacklist = {}

                    Window:Notify({ Title = "Merchant", Desc = "New merchant spawned! Heading over.", Duration = 3, Kind = "info" })

                    local prevPhase = State.phase
                    State.phase = "merchant"
                    pcall(function()
                        local r = State.fishingRemote
                        if r then r:InvokeServer({ Action = "Cancel" }) end
                    end)
                    pcall(function()
                        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                        if hum then hum:UnequipTools() end
                    end)
                    local w = 0; while HoroTpRunning and w < 3 do task.wait(0.1) w += 0.1 end
                    HoroTpRunning = false; task.wait(0.3)

                    if tweenToMerchant(pos) and State.active and State.merchantEnabled then
                        pcall(function()
                            local hrp = getFreshHRP()
                            if hrp then
                                local live = getMerchantPos() or pos
                                hrp.CFrame = CFrame.new(live + Vector3.new(0, 2.5, 0))
                                hrp.Velocity = Vector3.zero
                            end
                        end)
                        task.wait(0.5)
                        processMerchantPurchases()
                    else
                        Window:Notify({ Title = "Merchant", Desc = "Couldn't reach merchant.", Duration = 3, Kind = "warn" })
                        returnToFarm()
                    end

                    if State.active and State.phase == "merchant" then
                        State.phase = prevPhase == "merchant" and "fishing" or prevPhase
                    end
                end
            elseif found and not visible then
                State.lastMerchantPos = nil
            end
        end
        task.wait(5)
    end
    State.merchantThread = nil
end

local function startMerchantLoop()
    if State.merchantThread or not State.merchantEnabled then return end
    State.merchantThread = task.spawn(merchantLoop)
    State.connections.merchantThread = State.merchantThread
end

-- ============================================================
-- AUTO TITLE
-- ============================================================
local function getBestFishingTitle()
    local best, bestRank = nil, math.huge
    local ok, all = pcall(function()
        return HttpService:JSONDecode(getStatsFolder().Titles.AllTitles.Value)
    end)
    if not ok or not all then return nil end
    for rank, name in pairs(FISHING_TITLES) do
        if all[name] ~= nil and rank < bestRank then best = name bestRank = rank end
    end
    return best
end

local function getEquippedTitle()
    local ok, v = pcall(function()
        local eq = getStatsFolder().Titles.EquipedTitle
        return (eq and eq.Value ~= "") and eq.Value or nil
    end)
    return ok and v or nil
end

local function equipTitle(name)
    local ev = ReplicatedStorage:FindFirstChild("Events")
    local candidates = {
        ev and ev:FindFirstChild("Titles"), ev and ev:FindFirstChild("EquipTitle"),
        ev and ev:FindFirstChild("Title"),  ev and ev:FindFirstChild("TitleRemote"),
        ReplicatedStorage:FindFirstChild("EquipTitle"), ReplicatedStorage:FindFirstChild("TitleRemote"),
    }
    for _, r in ipairs(candidates) do
        if r then
            local ok = pcall(function()
                if r:IsA("RemoteEvent") then r:FireServer(name) else r:InvokeServer(name) end
            end)
            if ok then return true end
        end
    end
    return false
end

local function startAutoTitleLoop()
    if State.titleThread then return end
    State.titleThread = task.spawn(function()
        while State.autoEquipTitle do
            local best = getBestFishingTitle()
            if best and best ~= getEquippedTitle() then
                if equipTitle(best) then
                    Window:Notify({ Title = "Auto Title", Desc = "Equipped: " .. best, Duration = 3, Kind = "success" })
                end
            end
            task.wait(10)
        end
        State.titleThread = nil
    end)
end

-- ============================================================
-- MAIN CONTROLLER
-- ============================================================
local function startFishKaitun()
    if State.active then return end
    State.active              = true
    State.phase               = "goToFarm"
    State.sessionStartTime    = os.time()
    State.sessionCatches      = 0
    State.visitedMerchantPositions = {}
    State.lastMerchantPos     = nil
    table.clear(visitedChests)
    HoroTpRunning = false

    Window:Notify({ Title = "Fish Kaitun", Desc = "Starting up, heading to the farm.", Duration = 3, Kind = "info" })

    if State.autoSell then task.spawn(sellFish) task.wait(2) end

    State.thread = task.spawn(function()
        while State.active do
            local p = State.phase

            if p == "goToFarm" then
                local hrp = getFreshHRP()
                if hrp and (hrp.Position - FARM_POSITION).Magnitude > 20 then
                    tweenTeleport(FARM_POSITION, TRAVEL_SPEED, false); task.wait(0.5)
                end
                State.phase = "checkGear"

            elseif p == "checkGear" then
                if hasRod() and hasBait() then
                    State.phase = "fishing"
                elseif hasRod() and not hasBait() then
                    State.phase = getPeli() >= State.baitCost and "buyGear" or "farmChests"
                elseif getPeli() >= State.rodCost + State.baitCost * State.baitBuyAmount then
                    State.phase = "buyGear"
                else
                    State.phase = "farmChests"
                end

            elseif p == "farmChests" then
                Window:Notify({ Title = "Fish Kaitun", Desc = "Farming chests for Peli.", Duration = 3, Kind = "info" })
                farmChestsLoop()

            elseif p == "buyGear" then
                Window:Notify({ Title = "Fish Kaitun", Desc = "Picking up rod and bait.", Duration = 3, Kind = "info" })
                buyGearPhase()

            elseif p == "fishing" then
                autoFishLoop()

            elseif p == "merchant" then
                task.wait(0.5)

            else
                task.wait(0.5)
            end

            task.wait(0.2)
        end
        Window:Notify({ Title = "Fish Kaitun", Desc = "Stopped.", Duration = 3, Kind = "info" })
    end)

    if State.merchantEnabled then startMerchantLoop() end
end

local function stopFishKaitun()
    cleanup()
    Window:Notify({ Title = "Fish Kaitun", Desc = "Stopped.", Duration = 3, Kind = "warn" })
end

-- ============================================================
-- RETURN API (used by loader — mirrors Kaitun Farm pattern)
-- ============================================================
return {
    setWindow = function(w) _realWindow = w end,
    setFish   = function(v) if v then startFishKaitun() else stopFishKaitun() end end,

    setAutoSell = function(v) State.autoSell = v end,
    setSellRarities = function(t) State.sellRarities = t end,
    sellNow = function() task.spawn(sellFish) end,

    setBaitAmount = function(n) State.baitBuyAmount = n end,
    setRodPref    = function(v) State.rodPreference  = v or "Auto" end,
    setBaitPref   = function(v) State.baitPreference = v or "Auto" end,

    setAutoTitle = function(v)
        State.autoEquipTitle = v
        if v then startAutoTitleLoop() end
    end,
    equipBestTitleNow = function()
        local best = getBestFishingTitle()
        if best and equipTitle(best) then
            Window:Notify({ Title = "Auto Title", Desc = "Equipped: " .. best, Duration = 3, Kind = "success" })
        else
            Window:Notify({ Title = "Auto Title", Desc = "No fishing title found.", Duration = 3, Kind = "warn" })
        end
    end,

    setMerchantEnabled = function(v)
        State.merchantEnabled = v
        if v then
            if State.active then startMerchantLoop() end
        else
            if State.merchantThread then
                pcall(function()
                    if coroutine.status(State.merchantThread) ~= "dead" then
                        task.cancel(State.merchantThread)
                    end
                end)
                State.merchantThread = nil
                State.connections.merchantThread = nil
            end
        end
    end,
    setMerchantItems = function(t)
        local set = {}
        for _, name in ipairs(t) do set[name] = true end
        State.merchantBuyables  = set
        State.merchantBlacklist = {}
    end,
    buyMerchantNow = function()
        if next(State.merchantBuyables) == nil then
            Window:Notify({ Title = "Merchant", Desc = "Pick items first.", Duration = 2, Kind = "warn" })
            return
        end
        local found, visible = isMerchantVisible()
        if not found then Window:Notify({ Title = "Merchant", Desc = "Merchant isn't in this server.", Duration = 3, Kind = "warn" }) return end
        if not visible then Window:Notify({ Title = "Merchant", Desc = "Merchant is in the server but hasn't spawned yet.", Duration = 3, Kind = "warn" }) return end
        local pos = getMerchantPos()
        if not pos then Window:Notify({ Title = "Merchant", Desc = "Found merchant but position isn't ready yet.", Duration = 3, Kind = "warn" }) return end
        task.spawn(function()
            local was = State.active
            State.active = true
            State.merchantBlacklist = {}
            local w = 0; while HoroTpRunning and w < 3 do task.wait(0.1) w += 0.1 end
            HoroTpRunning = false; task.wait(0.3)
            if tweenToMerchant(pos) then
                pcall(function()
                    local hrp = getFreshHRP()
                    if hrp then
                        local live = getMerchantPos() or pos
                        hrp.CFrame = CFrame.new(live + Vector3.new(0, 2.5, 0))
                        hrp.Velocity = Vector3.zero
                    end
                end)
                task.wait(0.5)
                processMerchantPurchases()
            else
                Window:Notify({ Title = "Merchant", Desc = "Couldn't reach merchant.", Duration = 3, Kind = "warn" })
            end
            State.active = was
        end)
    end,

    setWebhook    = function(url) State.webhookUrl  = url end,
    setCatchNotify = function(v) State.catchNotify  = v end,
    sendTestWebhook = function()
        sendWebhook("Test Message 🔔", "This is a test from Kaitun Hub.", 3447003)
    end,

    getMerchantItems = function() return MERCHANT_ITEMS end,
}
