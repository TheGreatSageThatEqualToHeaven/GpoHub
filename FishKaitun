local function serverHop()
    Window:Notify({ Title = "Fish Kaitun", Desc = "No chests left — hopping servers.", Duration = 3, Kind = "warn" })
    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(
            "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        ))
    end)
    if ok and data and data.data then
        for _, sv in ipairs(data.data) do
            if sv.playing ~= sv.maxPlayers and sv.id ~= game.JobId then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, sv.id) end)
                task.wait(6)
                return
            end
        end
    end
    task.wait(10)
end

-- ============================================================
-- PHASE: FARM CHESTS
-- ============================================================
local visitedChests = {}

local function farmChestsLoop()
    State.phase = "farmChests"

    State.connections.promptClicker = task.spawn(function()
        while State.active and State.phase == "farmChests" do
            pcall(function()
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local env = workspace:FindFirstChild("Env")
                if not env then return end
                for _, obj in ipairs(env:GetChildren()) do
                    if obj.Name == "Part" and obj:IsA("BasePart") then
                        for _, d in ipairs(obj:GetDescendants()) do
                            if d:IsA("ProximityPrompt") and d.Enabled then
                                if (hrp.Position - obj.Position).Magnitude <= (d.MaxActivationDistance or 0) then
                                    pcall(fireproximityprompt, d)
                                end
                            end
                        end
                    end
                end
            end)
            RunService.Heartbeat:Wait()
        end
    end)

    local searchFails = 0
    while State.active and State.phase == "farmChests" do
        if getPeli() >= State.rodCost + State.baitCost * State.baitBuyAmount then
            State.phase = "buyGear"; break
        end
        local hrp = getFreshHRP()
        if not hrp then task.wait(1) continue end

        -- find nearest chest
        local env = workspace:FindFirstChild("Env")
        local nearest, minDist = nil, math.huge
        if env then
            for _, obj in ipairs(env:GetChildren()) do
                if obj.Name == "Part" and obj:IsA("BasePart") and not visitedChests[obj] then
                    for _, d in ipairs(obj:GetDescendants()) do
                        if d:IsA("ProximityPrompt") then
                            local dist = (hrp.Position - obj.Position).Magnitude
                            if dist < minDist then nearest, minDist = obj, dist end
                            break
                        end
                    end
                end
            end
        end

        if not nearest then
            searchFails = searchFails + 1
            local count = 0; for _ in pairs(visitedChests) do count = count + 1 end
            if count > 50 then table.clear(visitedChests) end
            if searchFails >= 3 then serverHop() searchFails = 0 end
            task.wait(1)
        else
            searchFails = 0
            visitedChests[nearest] = true
            tweenTeleport(nearest.Position + Vector3.new(0, 50, 0), TRAVEL_SPEED, false)
            if not State.active then break end
            tweenTeleport(nearest.Position + Vector3.new(0, 3, 0), TRAVEL_SPEED, false)
            task.wait(1)
            RunService.Heartbeat:Wait()
        end
    end

    pcall(function()
        local v = State.connections.promptClicker
        if type(v) == "thread" then task.cancel(v) end
        State.connections.promptClicker = nil
    end)
end

-- ============================================================
-- PHASE: BUY GEAR
-- ============================================================
local function buyGearPhase()
    State.phase = "buyGear"

    if not hasRod() then
        local target = SHOP_POS
        local lily = workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Lily")
        if lily then
            local part = lily:FindFirstChild("HumanoidRootPart") or lily.PrimaryPart
            if part then target = part.Position + Vector3.new(0, 3, 0) end
        end
        tweenTeleport(target, TRAVEL_SPEED, false)
        if not State.active then return end
        task.wait(0.5)
        pcall(function()
            ReplicatedStorage:WaitForChild("Events"):WaitForChild("Shop"):InvokeServer(
                workspace:WaitForChild("BuyableItems"):WaitForChild("Fishing Rod"), 1)
        end)
        task.wait(2)
        Window:Notify({ Title = "Fish Kaitun",
            Desc = hasRod() and "Rod purchased!" or "Rod purchase failed, retrying next loop.",
            Duration = 3, Kind = hasRod() and "success" or "warn" })
        if State.active then HoroTpRunning = false task.wait(0.3) tweenTeleport(FARM_POSITION, TRAVEL_SPEED, false) task.wait(0.5) end
    end

    if not State.active then return end

    if not hasBait() then
        local hrp = getFreshHRP()
        if hrp and (hrp.Position - SHOP_POS).Magnitude > 20 then
            tweenTeleport(SHOP_POS, TRAVEL_SPEED, false)
            if not State.active then return end
            task.wait(0.5)
        end
        pcall(function()
            ReplicatedStorage:WaitForChild("Events"):WaitForChild("Shop"):InvokeServer(
                workspace:WaitForChild("BuyableItems"):WaitForChild("Common Fish Bait"), State.baitBuyAmount)
        end)
        task.wait(2)
        Window:Notify({ Title = "Fish Kaitun",
            Desc = hasBait() and "Bait purchased!" or "Bait purchase failed, retrying next loop.",
            Duration = 3, Kind = hasBait() and "success" or "warn" })
        if State.active then HoroTpRunning = false task.wait(0.3) tweenTeleport(FARM_POSITION, TRAVEL_SPEED, false) task.wait(0.5) end
    end

    if State.active then
        HoroTpRunning = false; task.wait(0.3)
        tweenTeleport(FARM_POSITION, TRAVEL_SPEED, false); task.wait(0.5)
        State.phase = "fishing"
    end
end

-- ============================================================
-- PHASE: AUTO FISH
-- ============================================================
local function autoFishLoop()
    State.phase = "fishing"

    local FishingRemote
    local ok = pcall(function()
        FishingRemote = ReplicatedStorage
            :WaitForChild("Fishing", 10)
            :WaitForChild("Remotes", 10)
            :WaitForChild("Action", 10)
    end)
    if not ok or not FishingRemote then
        Window:Notify({ Title = "Fish Kaitun", Desc = "Couldn't find fishing remote.", Duration = 4, Kind = "error" })
        State.active = false; return
    end
    State.fishingRemote = FishingRemote

    local function equipRod()
        pcall(function()
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local bp  = player:FindFirstChild("Backpack")
            if hum and bp then
                local rod = bp:FindFirstChild(State.rodName)
                if rod then hum:EquipTool(rod) end
            end
        end)
        task.wait(0.5)
        if not (player.Character and player.Character:FindFirstChild(State.rodName)) then
            pcall(function()
                ReplicatedStorage:WaitForChild("Events"):WaitForChild("Tools")
                    :InvokeServer("equip", State.rodName)
            end)
            task.wait(0.5)
        end
    end

    Window:Notify({ Title = "Fish Kaitun", Desc = "Fishing started!", Duration = 3, Kind = "success" })
    if State.autoSell then task.spawn(sellFish) task.wait(1) end

    while State.active and State.phase == "fishing" do
        if not hasBait() then State.phase = "buyGear" return end

        equipRod()
        task.wait(1)

        local ch  = player.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(1) continue end

        local goal     = hrp.Position + hrp.CFrame.LookVector * 20
        local castTime = tick()

        pcall(function() FishingRemote:InvokeServer({ Action = "Throw", Bait = State.baitName, Goal = goal }) end)
        if not waitSec(1.5) then pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end) return end
        pcall(function() FishingRemote:InvokeServer({ Action = "Landed" }) end)

        local hookName = player.Name .. "'s hook"
        local hook
        for _ = 1, 20 do
            if not State.active then pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end) return end
            hook = workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild(hookName)
            if hook then break end
            task.wait(0.2)
        end

        if hook then
            hook.CFrame = CFrame.new(goal)
            local caught = false
            local t0     = tick()
            while hook.Parent and tick() - t0 < 15 and State.active and State.phase == "fishing" do
                pcall(function() caught = hook:GetAttribute("Caught") == true end)
                if caught then break end
                task.wait(0.2)
            end

            if not State.active then pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end) return end

            if caught then
                local elapsed = tick() - castTime
                State.sessionCatches = State.sessionCatches + 1
                Window:Notify({
                    Title    = "Fish Kaitun 🎣",
                    Desc     = string.format("Got one! Took %.1fs", elapsed),
                    Duration = 4, Kind = "success"
                })
                if State.catchNotify then
                    pcall(function()
                        local fn = Kaitun and (Kaitun.sendCatchWebhook or Kaitun.sendFishWebhook)
                        if fn then
                            fn(string.format("🎣 Caught a fish! Took %.1fs", elapsed))
                        else
                            sendWebhook("Fish Caught! 🎣",
                                string.format("Caught a fish in **%.1f seconds**.", elapsed), 3066993)
                        end
                    end)
                end
                if not waitSec(7.5) then pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end) return end
                pcall(function() FishingRemote:InvokeServer({ Action = "Reel" }) end)
                if not waitSec(0.5) then pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end) return end
                pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end)
            else
                Window:Notify({
                    Title    = "Fish Kaitun",
                    Desc     = string.format("No bite after %.1fs, recasting.", tick() - castTime),
                    Duration = 3, Kind = "warn"
                })
                pcall(function() FishingRemote:InvokeServer({ Action = "Cancel" }) end)
            end
        end

        if State.autoSell then task.spawn(sellFish) end
        if not waitSec(2) then return end
    end
end

